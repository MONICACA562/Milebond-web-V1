# Keep the static-asset bundle under Cloudflare's 20,000-file limit.
# blog-next/ is a local Next.js workspace; its output is copied into /blog/ already.
blog-next
.github
node_modules

# Internal ops notes (quote email templates, playbooks) — never served publicly.
docs

# Retired duplicates. Both are 301'd in _redirects and excluded from sitemap;
# keeping them out of the deployed bundle stops them from ever being served as
# a second, competing copy of /all-products and /products/sports-outdoors.
products/all-products.html
products/outdoor-sports.html
